# ─────────────────────────────────────────────────────────────────────────────
# Landing Zone — terraform.tfvars example
# Copy to each envs/<N>/terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Global ────────────────────────────────────────────────────────────────────
home_region = "cn-east-3"

# Set via environment variables (CI) or passed with -var flag:
# master_access_key = "AKIA..."
# master_secret_key = "..."

# ── Account domain names (find in IAM > Account Info > Domain Name) ───────────
network_ops_account_domain    = "network-ops-12345678"
logging_account_domain        = "log-archive-12345678"
security_ops_account_domain   = "security-ops-12345678"
ops_monitoring_account_domain = "ops-monitoring-12345678"
public_service_account_domain = "public-service-12345678"
sandbox_account_domain        = "sandbox-12345678"

# ── env/00-bootstrap ──────────────────────────────────────────────────────────
tfstate_bucket_name = "my-lz-tfstate-prod"

# ── env/01-foundation ─────────────────────────────────────────────────────────
master_account_id       = "1234567890abcdef"
log_archive_email       = "lz-log-archive@example.com"   # IMMUTABLE after apply
audit_email             = "lz-audit@example.com"          # IMMUTABLE after apply
log_archive_bucket_name = "my-lz-cts-archive"

additional_member_accounts = [
  {
    name        = "workload-prod"
    email       = "lz-workload-prod@example.com"
    parent_ou   = "Workloads"
    description = "Production workload account"
  },
  {
    name        = "workload-dev"
    email       = "lz-workload-dev@example.com"
    parent_ou   = "NonProduction"
    description = "Development workload account"
  },
]

sso_users = [
  {
    user_name    = "admin.user"
    family_name  = "User"
    given_name   = "Admin"
    email        = "admin.user@example.com"
    display_name = "Admin User"
    group_names  = ["LzAdministrators"]
  },
]

# ── env/02-network ────────────────────────────────────────────────────────────
hub_vpc_cidr         = "10.0.0.0/16"
hub_subnet_cidr      = "10.0.0.0/24"
firewall_subnet_cidr = "10.0.1.0/24"
availability_zones   = ["cn-east-3a", "cn-east-3b"]
enable_vpn_gateway   = false

tfstate_bucket = "my-lz-tfstate-prod"

# ── env/03-security-audit ─────────────────────────────────────────────────────
log_archive_bucket    = "my-lz-cts-archive"
alert_email_endpoints = ["soc-alerts@example.com"]
hss_quota_count       = 20
enable_dbss           = false

# ── env/04-ops-finance ────────────────────────────────────────────────────────
# alert_email_endpoints set above

# ── env/05-perimeter ─────────────────────────────────────────────────────────
enforce_mode  = false   # set true only after VPC endpoints verified in all spokes
deny_services = []
